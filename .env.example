# A chave publicável é própria para o cliente; habilite RLS e mantenha cadastro público desativado.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secrets exclusivos do servidor. Nunca use prefixo NEXT_PUBLIC_ nestes valores.
SUPABASE_SECRET_KEY=
OWNER_USER_ID=
RAPIDAPI_KEY=
# Primeiro dia do ciclo contratado de cada assinatura na RapidAPI, em AAAA-MM-DD.
# Sem a data da assinatura correspondente, consultas externas ficam bloqueadas.
RAPIDAPI_FLIGHTS_CYCLE_ANCHOR=
RAPIDAPI_STAYS_CYCLE_ANCHOR=
CRON_SECRET=
